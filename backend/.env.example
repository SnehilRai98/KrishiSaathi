# Copy this file to .env (same folder). Every setting is optional.

# Database. Leave unset to use the built-in SQLite file (backend/krishisaathi.db).
# For MySQL 8+ use:  mysql+pymysql://USER:PASSWORD@localhost:3306/krishisaathi
# (percent-encode special characters in the password, and create the database first:
#  CREATE DATABASE krishisaathi CHARACTER SET utf8mb4;)
# DATABASE_URL=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Advanced: use a different crop model / class-name list.
# CROP_MODEL_PATH=models/crop_disease_mobilenetv2_final.h5
# CROP_CLASS_NAMES_PATH=models/class_names.json

# Largest accepted leaf photo in megabytes (1-50). The frontend shows 10 MB in its hint;
# change Frontend/src/pages/CropHealth.tsx (MAX_MB) too if you change this.
# MAX_UPLOAD_MB=10

# Typo guard for each soil-test value in kg/ha (not an agronomic limit). The frontend form
# uses the default 10000; change MAX_SOIL_VALUE in Frontend/src/lib/fertilizer.ts too.
# NPK_MAX_VALUE=10000
